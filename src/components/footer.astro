---
import StarlightFooter from "@astrojs/starlight/components/Footer.astro";
---

<StarlightFooter />

{/* One outbound link, not the roster. Each site used to render the other four,
    which is N(N-1) links across the roster — 20 at five tools — and put four
    links nobody arrived for at the same visual weight as the one that sells. A
    tagwerk reader is on Arch tracking hours; colporteur turns newsletters into
    feeds. The overlap is nil, so the row read as a sitemap rather than a
    recommendation. `espadat.com/#tools` lists the whole roster with licences
    and is the page that converts, so it does that job once. See ADR-0001.

    Consequence worth keeping: the theme holds no roster and reads nothing off
    the Astro config, so a sixth tool needs no release here. */}
<div class="studio" data-pagefind-ignore>
  <hr class="rule" />
  <div class="studio-row data">
    <a class="credit" href="https://espadat.com">
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <path d="M6 7 H52 L28 43 H6 Z" fill="currentColor"></path>
        <rect x="6" y="49" width="52" height="7" fill="currentColor"></rect>
      </svg>
      <span>Designed and built by Espadat</span>
    </a>
    <a class="more" href="https://espadat.com/#tools">
      More tools<span aria-hidden="true"> &rarr;</span>
    </a>
  </div>
</div>

<style>
  .studio {
    margin-top: 3rem;
  }
  .studio-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .credit {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  /* Frozen geometry, transcribed from espadat.com's design/mark.svg, which
     design/mark.md calls the only source — there is no build step here to
     derive it. Re-sync by hand if that file ever moves. 20px clears the 16px
     floor the mark is verified down to. */
  .mark {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .more {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
